# PathWarden Backend Environment Variables Configuration

PATHWARDEN_ENV=development
PATHWARDEN_HOST=0.0.0.0
PATHWARDEN_PORT=8000
PATHWARDEN_DATA_DIR=./data
PATHWARDEN_LOG_DIR=./logs
PATHWARDEN_MAX_MEMORY_GB=8.0
PATHWARDEN_LOG_LEVEL=INFO
PATHWARDEN_STORAGE_ENGINE=duckdb
PATHWARDEN_TEMPORAL_WINDOW_SECONDS=300
PATHWARDEN_MAX_GAP_SECONDS=600

